default_platform(:ios)

platform :ios do
  desc "Build voyage and upload a new build to TestFlight"
  lane :beta do
    setup_ci

    api_key = asc_api_key

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"],
      xcodeproj: "voyage.xcodeproj"
    )

    match(
      type: "appstore",
      api_key: api_key,
      readonly: false
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "voyage.xcodeproj",
      team_id: "LP4YVQGGQL",
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_com.anmol.voyage_appstore_profile-name"],
      bundle_identifier: "com.anmol.voyage",
      targets: ["voyage"]
    )

    build_app(
      scheme: "voyage",
      configuration: "Release",
      export_method: "app-store"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false,
      uses_non_exempt_encryption: false
    )
  end

  desc "Upload the App Store listing for a version: screenshots, What's New and promotional text"
  desc "Run by store-listing.yml; never submits for review"
  lane :listing do |options|
    # Creates the version in App Store Connect if it isn't there yet, and
    # fills the one being prepared for submission. Text comes from
    # fastlane/metadata/en-US; only the files present there are sent.
    upload_to_app_store(
      api_key: asc_api_key,
      app_version: options.fetch(:version),
      skip_binary_upload: true,
      skip_screenshots: options[:screenshots] == false,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true
    )
  end

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false
    )
  end
end
