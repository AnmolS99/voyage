# Upload-key credentials for signed release builds.
#
#   cp keystore.properties.example keystore.properties
#
# then fill in the two passwords. keystore.properties is gitignored and must
# stay that way — see docs/ANDROID_DEVELOPMENT.md.
#
# storeFile may begin with ~: keep the keystore outside the repo, never in it.
storeFile=~/voyage-android-upload.keystore
storePassword=
keyAlias=voyage-android-upload
keyPassword=
