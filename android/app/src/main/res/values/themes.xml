<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns all in-app colors (see ui/theme/Theme.kt); this platform theme
      only covers the window before the first frame and the edge-to-edge setup.
    -->
    <style name="Theme.Voyage" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/voyage_page_bg_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Launch theme: Splash Screen API, handed over to Theme.Voyage on first frame. -->
    <style name="Theme.Voyage.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/voyage_orange</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Voyage</item>
    </style>
</resources>
