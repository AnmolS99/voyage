<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The achievement-unlock pattern is a vibration composition, not a
         View haptic constant; see UnlockCelebration.kt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".VoyageApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Voyage"
        tools:targetApi="33">

        <activity
            android:name=".VoyageActivity"
            android:exported="false"
            android:theme="@style/Theme.Voyage.Starting"
            android:windowSoftInputMode="adjustResize" />

        <!-- The launcher entries: one per app icon, exactly one enabled at a
             time (ui/settings/AppIconSetting.kt). The light one keeps the
             .MainActivity name the launcher entry has always had, so icons
             already on a home screen survive the update. -->
        <activity-alias
            android:name=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:targetActivity=".VoyageActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".DarkIconActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:targetActivity=".VoyageActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
